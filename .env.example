APP_NAME=Evidence-First Contract & Document Risk Assistant
APP_ENV=development
APP_VERSION=0.1.0
DEBUG=true
MAX_UPLOAD_SIZE_BYTES=26214400
MAX_PDF_PAGE_COUNT=250
MAX_PDF_CHUNK_COUNT=5000

# Replace with your Neon connection string locally.
# Do not commit .env or paste secrets into issues, screenshots, or chat.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/DATABASE

OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536